# Optional: used by scripts/generate-release-notes.mjs for AI-written release notes.
# Copy this file to .env or .env.local and fill in your key.
OPENAI_API_KEY=
OPENAI_RELEASE_NOTES_MODEL=gpt-5.4-nano
VT_API_KEY=

# Public KKMod catalog values embedded into the desktop build. These production
# defaults are also pinned in src-tauri/build.rs. Override both together only
# for a staging catalog or signing-key rotation. An empty URL is baseline-only.
KKTERM_CUSTOM_MODULE_CATALOG_PUBLIC_KEY=16e4c35d77a52dcefca62fed9f5fea8874a8790f212f9a81be9bcd04222eaabc
KKTERM_CUSTOM_MODULE_CATALOG_URL=https://modules.kkterm.ryantsai.com/catalog/v2/catalog.json
KKTERM_CUSTOM_MODULE_SIGNING_KEY_PASSPHRASE=
