# Optional: used by scripts/generate-release-notes.mjs for AI-written release notes.
# Copy this file to .env or .env.local and fill in your key.
OPENAI_API_KEY=
OPENAI_RELEASE_NOTES_MODEL=gpt-5.4-nano
VT_API_KEY=

# Public KKMod catalog values embedded into the desktop build.
# Copy this file to .env and replace both values for release builds.
# Leave both empty to use only the baseline catalog bundled with KKTerm.
KKTERM_CUSTOM_MODULE_CATALOG_PUBLIC_KEY=
KKTERM_CUSTOM_MODULE_CATALOG_URL=
