{
  "id": "com.kkterm.excalidraw",
  "name": "Excalidraw",
  "version": "2.0.1",
  "publisher": "KKTerm",
  "summary": "An unofficial offline Excalidraw integration for KKTerm.",
  "apiVersion": 2,
  "homepage": "https://excalidraw.com",
  "license": {
    "name": "MIT",
    "file": "licenses/LICENSE",
    "noticesFile": "licenses/THIRD_PARTY_NOTICES.txt"
  },
  "permissions": {
    "documentStorage": true,
    "browserStorage": true,
    "openExternal": true,
    "clipboard": true,
    "hostUi": true,
    "files": {
      "open": true,
      "save": true,
      "extensions": [
        "excalidraw",
        "excalidrawlib",
        "json",
        "png",
        "svg",
        "jpg",
        "jpeg",
        "gif",
        "webp",
        "bmp",
        "ico",
        "avif",
        "jfif"
      ]
    }
  },
  "modules": [
    {
      "id": "excalidraw",
      "title": "Excalidraw",
      "icon": "dist/icon.svg",
      "entrypoint": "dist/index.html",
      "railVisible": true,
      "routing": "spa"
    }
  ]
}
