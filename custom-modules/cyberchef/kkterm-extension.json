  "permissions": {
    "browserStorage": true,
    "openExternal": true,
    "clipboard": true,
    "hostUi": true,
    "files": {
      "open": true,
      "save": true,
      "extensions": []
    }
  },
  "modules": [
    {
      "id": "cyberchef",
      "title": "CyberChef",
      "icon": "dist/icon.svg",
      "entrypoint": "dist/index.html",
      "railVisible": true,
      "routing": "static"
    }
  ]
