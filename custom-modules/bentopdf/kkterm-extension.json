{
  "id": "com.kkterm.bentopdf",
  "name": "BentoPDF",
  "version": "2.8.9",
  "publisher": "KKTerm",
  "summary": "An unofficial self-contained BentoPDF integration for KKTerm API v2.",
  "apiVersion": 2,
  "homepage": "https://bentopdf.com",
  "license": {
    "name": "AGPL-3.0-only",
    "file": "licenses/LICENSE",
    "noticesFile": "licenses/THIRD_PARTY_NOTICES.txt"
  },
  "permissions": {
    "browserStorage": true,
    "openExternal": true,
    "clipboard": true,
    "files": {
      "open": true,
      "save": true,
      "extensions": [
        "pdf", "jpg", "jpeg", "png", "webp", "gif", "bmp", "tif", "tiff",
        "heic", "heif", "svg", "txt", "md", "json", "csv", "xls", "xlsx",
        "doc", "docx", "odt", "ods", "odp", "ppt", "pptx", "rtf", "xps",
        "mobi", "epub", "fb2", "cbz", "cbr", "wpd", "wps", "pages", "pub",
        "vsd", "vsdx", "odg", "oxps", "eml", "msg", "psd", "xml", "p12",
        "pfx", "pem", "crt", "cer", "der", "key", "ttf", "otf", "jp2",
        "jpx", "jxr", "pam", "pbm", "pgm", "pnm", "ppm", "zip"
      ]
    },
    "networkFetch": {
      "origins": ["https://freetsa.org"],
      "methods": ["POST"],
      "allowPrivateNetwork": false,
      "maxResponseBytes": 1048576
    }
  },
  "modules": [
    {
      "id": "bentopdf",
      "title": "BentoPDF",
      "icon": "dist/icon.svg",
      "entrypoint": "dist/index.html",
      "railVisible": true,
      "routing": "static"
    }
  ]
}
