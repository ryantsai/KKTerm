    "jwt-decode": "^4.0.0",
    "konva": "^10.10.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "mathjs": "^15.2.0",
    "matter-js": "^0.20.0",
    "mermaid": "^12.3.0",
    "motion": "^14.14.0",
    "papaparse": "^5.7.1",
    "pica": "^10.0.3",
    "pixi.js": "^8.23.0",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-i18next": "^18.0.3",
    "react-linear-gradient-picker": "^5.0.0",
    "react-resizable": "^4.0.2",
    "reicon-react": "1.2.6",
    "roughjs": "^4.6.6",
    "simple-statistics": "^8.0.0",
    "thinking-orbs": "^0.3.2",
    "three": "^0.187.0",
