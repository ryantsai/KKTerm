{
  "name": "kkterm",
  "private": true,
  "version": "0.1.147",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "check": "npm run lint && node tests/run-all.mjs && tsc --noEmit",
    "check:all": "npm run check && cargo test --manifest-path src-tauri/Cargo.toml",
    "package:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-installer.ps1",
    "package:installer:arm64": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-installer-arm64.ps1",
    "package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "package:portable:arm64": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1 -Arch arm64",
    "package:macos": "zsh scripts/package-macos.sh",
    "package:linux": "bash scripts/package-linux.sh",
    "package:custom-module-fixture": "node scripts/package-custom-module-fixture.mjs",
    "publish:custom-module": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-custom-module.ps1",
    "release:github": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-github.ps1",
    "release:github:both-arch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-github-both-arch.ps1",
    "release:github:macos": "zsh scripts/release-github-macos.sh",
    "release:github:linux": "bash scripts/release-github-linux.sh",
    "release:mirror": "node scripts/sync-cloudflare-release.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "smoke:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-installer.ps1",
    "smoke:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-portable.ps1",
    "i18n:check": "node scripts/check-locale-keys.mjs",
    "i18n:normalize": "node scripts/normalize-locale-order.mjs",
    "terminal-colors:sync": "node scripts/sync-terminal-colors-catalog.mjs",
    "measure:ssh-readiness": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure-ssh-readiness.ps1",
    "preview": "vite preview",
    "tauri": "tauri"
  },
