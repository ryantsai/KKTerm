    "cronstrue": "^3.43.0",
    "dayjs": "^1.11.23",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.5.0",
    "fflate": "^0.8.3",
    "fuse.js": "^7.5.0",
    "gridjs": "^6.2.0",
    "i18next": "^27.2.4",
